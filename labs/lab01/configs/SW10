hostname SW10
!
no ip domain-lookup
!
spanning-tree mode rapid-pvst
spanning-tree vlan 90,99 root primary
spanning-tree vlan 80 root secondary
!
vlan 80
 name USERS-VPC8
!
vlan 90
 name USERS-VPC
!
vlan 99
 name MGMT
!
vlan 999
 name NATIVE-UNUSED
!
interface Port-channel1
 description LACP to SW9
 switchport trunk encapsulation dot1q
 switchport trunk native vlan 999
 switchport trunk allowed vlan 80,90,99
 switchport mode trunk
!
interface Ethernet0/0
 description Po1 to SW9 e0/0
 switchport trunk encapsulation dot1q
 switchport trunk native vlan 999
 switchport trunk allowed vlan 80,90,99
 switchport mode trunk
 channel-group 1 mode active
 no shutdown
!
interface Ethernet0/1
 description Po1 to SW9 e0/1
 switchport trunk encapsulation dot1q
 switchport trunk native vlan 999
 switchport trunk allowed vlan 80,90,99
 switchport mode trunk
 channel-group 1 mode active
 no shutdown
!
interface Ethernet0/2
 description VPC
 switchport mode access
 switchport access vlan 90
 spanning-tree portfast edge
 spanning-tree bpduguard enable
 no shutdown
!
interface Ethernet0/3
 description to R16 e0/0
 switchport trunk encapsulation dot1q
 switchport trunk native vlan 999
 switchport trunk allowed vlan 90,99
 switchport mode trunk
 spanning-tree portfast edge trunk
 no shutdown
!
interface Ethernet1/0
 description to R17 e0/2
 switchport trunk encapsulation dot1q
 switchport trunk native vlan 999
 switchport trunk allowed vlan 80
 switchport mode trunk
 spanning-tree portfast edge trunk
 no shutdown
!
interface Ethernet1/1
 description unused
 switchport mode access
 switchport access vlan 999
 shutdown
!
interface Ethernet1/2
 description unused
 switchport mode access
 switchport access vlan 999
 shutdown
!
interface Ethernet1/3
 description unused
 switchport mode access
 switchport access vlan 999
 shutdown
!
interface Vlan99
 description Management
 ip address 10.20.99.100 255.255.255.0
 no shutdown
!
ip default-gateway 10.20.99.1
!
line con 0
 logging synchronous
 exec-timeout 0 0
!
end
