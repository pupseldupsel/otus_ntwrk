 ipv6 address 2001:db8:2042:1632::16/64
 no shutdown
!
! ---------- lab05: EIGRP named-mode ----------
ip prefix-list PL-DEFAULT-ONLY seq 5 permit 0.0.0.0/0
ipv6 prefix-list PL6-DEFAULT-ONLY seq 5 permit ::/0
!
router eigrp SPB
 !
 address-family ipv4 unicast autonomous-system 2042
  !
  af-interface default
   passive-interface
  exit-af-interface
  !
  af-interface Ethernet0/1
   no passive-interface
   summary-address 10.20.0.0 255.255.0.0
  exit-af-interface
  !
  af-interface Ethernet0/3
   no passive-interface
  exit-af-interface
  !
  af-interface Ethernet0/0.99
   no passive-interface
  exit-af-interface
  network 10.20.0.0 0.0.255.255
  !
  topology base
   distribute-list prefix PL-DEFAULT-ONLY out Ethernet0/3
  exit-af-topology
  eigrp router-id 10.20.255.16
 exit-address-family
 !
 address-family ipv6 unicast autonomous-system 2042
  !
  af-interface default
   passive-interface
  exit-af-interface
  !
  af-interface Ethernet0/1
   no passive-interface
   summary-address 2001:db8:2042::/48
  exit-af-interface
  !
  af-interface Ethernet0/3
   no passive-interface
  exit-af-interface
  !
  af-interface Ethernet0/0.99
   no passive-interface
  exit-af-interface
  !
  topology base
   distribute-list prefix-list PL6-DEFAULT-ONLY out Ethernet0/3
  exit-af-topology
  eigrp router-id 10.20.255.16
 exit-address-family
!
line con 0
 logging synchronous
 exec-timeout 0 0
!
end
