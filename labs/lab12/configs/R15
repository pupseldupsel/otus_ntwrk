! ---------- lab11: GRE to SPb ----------
interface Tunnel0
 description GRE to R18 (SPb)
 ip address 10.100.0.1 255.255.255.252
 ip mtu 1400
 ip tcp adjust-mss 1360
 keepalive 10 3
 tunnel source Loopback1
 tunnel destination 20.42.0.18
!
ip route 10.20.0.0 255.255.0.0 10.100.0.2
!
! ---------- lab12: IPSec ----------
crypto pki trustpoint OTUS
 enrollment url http://100.1.0.14:80
 subject-name CN=R15.otus.lab,O=OTUS
 serial-number none
 ip-address none
 revocation-check none
 rsakeypair R15-KEY 2048
!
crypto isakmp policy 10
 encr aes 256
 hash sha256
 authentication rsa-sig
 group 14
!
crypto ipsec transform-set TS-AES256 esp-aes 256 esp-sha256-hmac
 mode transport
!
crypto ipsec profile PROF-IPSEC
 set transform-set TS-AES256
!
interface Tunnel0
 tunnel protection ipsec profile PROF-IPSEC
!
line con 0
 logging synchronous
 exec-timeout 0 0
!
end
