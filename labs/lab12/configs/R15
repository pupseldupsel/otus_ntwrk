! ---------- lab06: eBGP ----------
interface Loopback1
 description Public / BGP test
 ip address 100.1.0.15 255.255.255.255
 ip ospf 1 area 0
!
ip route 100.1.0.0 255.255.255.0 Null0 254
!
router bgp 1001
 bgp router-id 10.10.255.15
 bgp log-neighbor-changes
 neighbor 30.1.0.1 remote-as 301
 neighbor 30.1.0.1 description R21 Lamas
 !
 address-family ipv4
  network 100.1.0.0 mask 255.255.255.0
  neighbor 30.1.0.1 activate
 exit-address-family
!
! ---------- lab07: iBGP ----------
route-map RM-LAMAS-IN permit 10
 description Lamas = primary
 set local-preference 150
!
router bgp 1001
 neighbor 10.10.255.14 remote-as 1001
 neighbor 10.10.255.14 description R14 iBGP
 neighbor 10.10.255.14 update-source Loopback0
 !
 address-family ipv4
  neighbor 10.10.255.14 activate
  neighbor 10.10.255.14 next-hop-self
  neighbor 30.1.0.1 route-map RM-LAMAS-IN in
 exit-address-family
!
! ---------- lab08: BGP filtering ----------
ip as-path access-list 1 permit ^$
!
router bgp 1001
 address-family ipv4
  neighbor 30.1.0.1 filter-list 1 out
 exit-address-family
!
! ---------- lab09: BGP IPv6 ----------
ipv6 route 2001:db8:1001::/48 Null0 254
!
router bgp 1001
 neighbor 2001:db8:301:1521::21 remote-as 301
 neighbor 2001:db8:301:1521::21 description R21 Lamas
 neighbor 2001:db8:1001:ffff::14 remote-as 1001
 neighbor 2001:db8:1001:ffff::14 description R14 iBGP
 neighbor 2001:db8:1001:ffff::14 update-source Loopback0
 !
 address-family ipv4
  no neighbor 2001:db8:301:1521::21 activate
  no neighbor 2001:db8:1001:ffff::14 activate
 exit-address-family
 !
 address-family ipv6
  network 2001:db8:1001::/48
  neighbor 2001:db8:301:1521::21 activate
  neighbor 2001:db8:301:1521::21 filter-list 1 out
  neighbor 2001:db8:301:1521::21 route-map RM-LAMAS-IN in
  neighbor 2001:db8:1001:ffff::14 activate
  neighbor 2001:db8:1001:ffff::14 next-hop-self
 exit-address-family
!
