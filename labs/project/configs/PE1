hostname PE1
!
no ip domain-lookup
service timestamps log datetime msec localtime
clock timezone MSK 3 0
ipv6 unicast-routing
ipv6 cef
!
aaa new-model
aaa authentication login CONSOLE none
aaa authentication login VTY local
aaa authorization exec VTY local
username admin privilege 15 secret otus
!
mpls label protocol ldp
mpls ldp router-id Loopback0 force
!
interface Loopback0
 description Router-ID / iBGP / LDP
 ip address 10.0.0.21 255.255.255.255
 ipv6 address 2001:db8:100:ffff::21/128
!
interface Ethernet0/0
 description backbone to P1
 ip address 10.1.0.6 255.255.255.252
 ip router isis ISP
 isis network point-to-point
 mpls ip
 bfd interval 300 min_rx 300 multiplier 3
 no shutdown
!
interface Ethernet0/1
 description backbone to P2
 ip address 10.1.0.26 255.255.255.252
 ip router isis ISP
 isis network point-to-point
 mpls ip
 bfd interval 300 min_rx 300 multiplier 3
 no shutdown
!
router isis ISP
 net 49.0001.0000.0000.0021.00
 is-type level-2-only
 metric-style wide
 log-adjacency-changes
 passive-interface Loopback0
 bfd all-interfaces
!
ntp source Loopback0
ntp server 10.0.0.11 prefer
ntp server 10.0.0.12
!
ip bgp-community new-format
ip community-list standard CL-CUST-BACKUP permit 64500:90
!
ip prefix-list PL-CUST-AS64600 seq 5 permit 203.0.113.0/24
ip prefix-list PL-NONE seq 5 deny 0.0.0.0/0 le 32
ipv6 prefix-list PL6-CUST-AS64600 seq 5 permit 2001:db8:600::/48
ipv6 prefix-list PL6-NONE seq 5 deny ::/0 le 128
!
ip prefix-list PL-UPSTREAM-CHECK seq 5 permit 198.51.100.0/24
ipv6 prefix-list PL6-UPSTREAM-CHECK seq 5 permit 2001:db8:999::/48
!
route-map RM-DEFAULT-COND permit 10
 description default to customer only while internet is reachable
 match ip address prefix-list PL-UPSTREAM-CHECK
!
route-map RM6-DEFAULT-COND permit 10
 match ipv6 address prefix-list PL6-UPSTREAM-CHECK
!
route-map RM-CUST-IN permit 10
 description customer asked for backup (community 64500:90)
 match ip address prefix-list PL-CUST-AS64600
 match community CL-CUST-BACKUP
 set local-preference 90
 set community 64500:100 additive
route-map RM-CUST-IN permit 20
 match ip address prefix-list PL-CUST-AS64600
 set community 64500:100 additive
!
route-map RM6-CUST-IN permit 10
 match ipv6 address prefix-list PL6-CUST-AS64600
 match community CL-CUST-BACKUP
 set local-preference 90
 set community 64500:100 additive
route-map RM6-CUST-IN permit 20
 match ipv6 address prefix-list PL6-CUST-AS64600
 set community 64500:100 additive
!
vrf definition CORP
 description L3VPN for corporate client
 rd 64500:10
 route-target export 64500:10
 route-target import 64500:10
 !
 address-family ipv4
 exit-address-family
!
interface Ethernet0/3
 description eBGP to CUST AS64600
 ip address 192.0.2.1 255.255.255.252
 ipv6 address 2001:db8:100:f001::1/64
 no shutdown
!
interface Ethernet0/2
 description L3VPN CORP to CE-A
 vrf forwarding CORP
 ip address 172.31.0.1 255.255.255.252
 no shutdown
!
router ospf 10 vrf CORP
 router-id 172.31.0.1
 redistribute bgp 64500 subnets
 network 172.31.0.0 0.0.0.3 area 0
!
router bgp 64500
 bgp router-id 10.0.0.21
 bgp log-neighbor-changes
 no bgp default ipv4-unicast
 neighbor 10.0.0.11 remote-as 64500
 neighbor 10.0.0.11 description BR1 RR
 neighbor 10.0.0.11 update-source Loopback0
 neighbor 10.0.0.12 remote-as 64500
 neighbor 10.0.0.12 description BR2 RR
 neighbor 10.0.0.12 update-source Loopback0
 neighbor 192.0.2.2 remote-as 64600
 neighbor 192.0.2.2 description CUST
 neighbor 2001:db8:100:f001::2 remote-as 64600
 neighbor 2001:db8:100:f001::2 description CUST IPv6
 !
 address-family ipv4
  neighbor 10.0.0.11 activate
  neighbor 10.0.0.11 send-community
  neighbor 10.0.0.11 next-hop-self
  neighbor 10.0.0.12 activate
  neighbor 10.0.0.12 send-community
  neighbor 10.0.0.12 next-hop-self
  neighbor 192.0.2.2 activate
  neighbor 192.0.2.2 default-originate route-map RM-DEFAULT-COND
  neighbor 192.0.2.2 prefix-list PL-NONE out
  neighbor 192.0.2.2 route-map RM-CUST-IN in
  neighbor 192.0.2.2 maximum-prefix 10 90
 exit-address-family
 !
 address-family ipv6
  neighbor 10.0.0.11 activate
  neighbor 10.0.0.11 send-community
  neighbor 10.0.0.11 send-label
  neighbor 10.0.0.11 next-hop-self
  neighbor 10.0.0.12 activate
  neighbor 10.0.0.12 send-community
  neighbor 10.0.0.12 send-label
  neighbor 10.0.0.12 next-hop-self
  neighbor 2001:db8:100:f001::2 activate
  neighbor 2001:db8:100:f001::2 default-originate route-map RM6-DEFAULT-COND
  neighbor 2001:db8:100:f001::2 prefix-list PL6-NONE out
  neighbor 2001:db8:100:f001::2 route-map RM6-CUST-IN in
  neighbor 2001:db8:100:f001::2 maximum-prefix 10 90
 exit-address-family
 !
 address-family vpnv4
  neighbor 10.0.0.11 activate
  neighbor 10.0.0.11 send-community extended
  neighbor 10.0.0.12 activate
  neighbor 10.0.0.12 send-community extended
 exit-address-family
 !
 address-family ipv4 vrf CORP
  redistribute ospf 10 match internal external 1 external 2
 exit-address-family
!
line con 0
 logging synchronous
 exec-timeout 0 0
 login authentication CONSOLE
line vty 0 4
 login authentication VTY
 authorization exec VTY
 transport input telnet
!
end
