hostname INET
!
no ip domain-lookup
service timestamps log datetime msec localtime
clock timezone MSK 3 0
ipv6 unicast-routing
ipv6 cef
!
interface Loopback1
 description announced prefix
 ip address 198.51.100.1 255.255.255.255
 ipv6 address 2001:db8:999::1/48
!
interface Ethernet0/0
 description to UP1
 ip address 198.18.0.10 255.255.255.252
 ipv6 address 2001:db8:510:3::2/64
 no shutdown
!
interface Ethernet0/1
 description to UP2
 ip address 198.19.0.6 255.255.255.252
 ipv6 address 2001:db8:520:3::2/64
 no shutdown
!
interface Loopback2
 description public DNS (test target)
 ip address 198.51.100.53 255.255.255.255
!
ip route 198.51.100.0 255.255.255.0 Null0 254
ipv6 route 2001:db8:999::/48 Null0 254
!
router bgp 64999
 bgp router-id 198.51.100.1
 bgp log-neighbor-changes
 no bgp default ipv4-unicast
 neighbor 198.18.0.9 remote-as 64510
 neighbor 198.18.0.9 description UP1
 neighbor 198.19.0.5 remote-as 64520
 neighbor 198.19.0.5 description UP2
 neighbor 2001:db8:510:3::1 remote-as 64510
 neighbor 2001:db8:510:3::1 description UP1
 neighbor 2001:db8:520:3::1 remote-as 64520
 neighbor 2001:db8:520:3::1 description UP2
 !
 address-family ipv4
  network 198.51.100.0 mask 255.255.255.0
  neighbor 198.18.0.9 activate
  neighbor 198.19.0.5 activate
 exit-address-family
 !
 address-family ipv6
  network 2001:db8:999::/48
  neighbor 2001:db8:510:3::1 activate
  neighbor 2001:db8:520:3::1 activate
 exit-address-family
!
line con 0
 logging synchronous
 exec-timeout 0 0
line vty 0 4
 login
 transport input telnet
!
end
