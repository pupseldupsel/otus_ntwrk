! ---------- lab07: iBGP ----------
route-map RM-KITORN-OUT permit 10
 description Kitorn = backup: prepend
 set as-path prepend 1001 1001
!
router ospf 1
 default-information originate metric 50
!
router bgp 1001
 neighbor 10.10.255.15 remote-as 1001
 neighbor 10.10.255.15 description R15 iBGP
 neighbor 10.10.255.15 update-source Loopback0
 !
 address-family ipv4
  neighbor 10.10.255.15 activate
  neighbor 10.10.255.15 next-hop-self
  neighbor 101.0.0.1 route-map RM-KITORN-OUT out
 exit-address-family
!
