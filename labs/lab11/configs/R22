hostname R22
!
no ip domain-lookup
ipv6 unicast-routing
!
interface Loopback0
 description Management / Router-ID
 ip address 101.0.255.22 255.255.255.255
 ipv6 address 2001:db8:101:ffff::22/128
!
interface Ethernet0/0
 description to R14
 ip address 101.0.0.1 255.255.255.252
 ipv6 address fe80::22 link-local
 ipv6 address 2001:db8:101:1422::22/64
 no shutdown
!
interface Ethernet0/1
 description to R21
 ip address 101.0.0.5 255.255.255.252
 ipv6 address fe80::22 link-local
 ipv6 address 2001:db8:101:2122::22/64
 no shutdown
!
interface Ethernet0/2
 description to R23
 ip address 101.0.0.9 255.255.255.252
 ipv6 address fe80::22 link-local
 ipv6 address 2001:db8:101:2223::22/64
 no shutdown
!
! ---------- lab06: eBGP ----------
ip route 101.0.0.0 255.255.0.0 Null0 254
!
router bgp 101
 bgp router-id 101.0.255.22
 bgp log-neighbor-changes
 neighbor 101.0.0.2 remote-as 1001
 neighbor 101.0.0.2 description R14 Moscow
 neighbor 101.0.0.6 remote-as 301
 neighbor 101.0.0.6 description R21 Lamas
 !
 address-family ipv4
  network 101.0.0.0 mask 255.255.0.0
  neighbor 101.0.0.2 activate
  neighbor 101.0.0.6 activate
 exit-address-family
!
! ---------- lab08: BGP filtering ----------
ip prefix-list PL-TO-MOSCOW seq 5 permit 0.0.0.0/0
!
router bgp 101
 address-family ipv4
  neighbor 101.0.0.2 default-originate
  neighbor 101.0.0.2 prefix-list PL-TO-MOSCOW out
 exit-address-family
!
! ---------- lab09: BGP IPv6 ----------
ipv6 prefix-list PL6-TO-MOSCOW seq 5 permit ::/0
!
ipv6 route 2001:db8:101::/48 Null0 254
!
router bgp 101
 neighbor 2001:db8:101:1422::14 remote-as 1001
 neighbor 2001:db8:101:1422::14 description R14 Moscow
 neighbor 2001:db8:101:2122::21 remote-as 301
 neighbor 2001:db8:101:2122::21 description R21 Lamas
 !
 address-family ipv4
  no neighbor 2001:db8:101:1422::14 activate
  no neighbor 2001:db8:101:2122::21 activate
 exit-address-family
 !
 address-family ipv6
  network 2001:db8:101::/48
  neighbor 2001:db8:101:1422::14 activate
  neighbor 2001:db8:101:1422::14 default-originate
  neighbor 2001:db8:101:1422::14 prefix-list PL6-TO-MOSCOW out
  neighbor 2001:db8:101:2122::21 activate
 exit-address-family
!
line con 0
 logging synchronous
 exec-timeout 0 0
!
end
