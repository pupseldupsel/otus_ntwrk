hostname R20
!
no ip domain-lookup
ipv6 unicast-routing
!
interface Loopback0
 description Management / Router-ID
 ip address 10.10.255.20 255.255.255.255
 ipv6 address 2001:db8:1001:ffff::20/128
!
interface Ethernet0/0
 description to R15
 ip address 10.10.0.22 255.255.255.252
 ipv6 address fe80::20 link-local
 ipv6 address 2001:db8:1001:1520::20/64
 no shutdown
!
! ---------- lab03: OSPF ----------
ipv6 prefix-list PL6-NO-AREA101 seq 5 deny 2001:db8:1001:1419::/64
ipv6 prefix-list PL6-NO-AREA101 seq 10 deny 2001:db8:1001:ffff::19/128
ipv6 prefix-list PL6-NO-AREA101 seq 100 permit ::/0 le 128
!
router ospf 1
 router-id 10.10.255.20
 passive-interface Loopback0
!
ipv6 router ospf 1
 router-id 10.10.255.20
 passive-interface Loopback0
 distribute-list prefix-list PL6-NO-AREA101 in
!
interface Ethernet0/0
 ip ospf 1 area 102
 ipv6 ospf 1 area 102
 ip ospf network point-to-point
 ipv6 ospf network point-to-point
!
interface Loopback0
 ip ospf 1 area 102
 ipv6 ospf 1 area 102
!
line con 0
 logging synchronous
 exec-timeout 0 0
!
end
