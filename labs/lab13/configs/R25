hostname R25
!
no ip domain-lookup
ipv6 unicast-routing
!
interface Loopback0
 description Management / Router-ID
 ip address 52.0.255.25 255.255.255.255
 ipv6 address 2001:db8:520:ffff::25/128
!
interface Ethernet0/0
 description to R23
 ip address 52.0.0.2 255.255.255.252
 ipv6 address fe80::25 link-local
 ipv6 address 2001:db8:520:2325::25/64
 no shutdown
!
interface Ethernet0/1
 description to R27
 ip address 52.0.1.9 255.255.255.252
 ipv6 address fe80::25 link-local
 ipv6 address 2001:db8:520:2527::25/64
 no shutdown
!
interface Ethernet0/2
 description to R26
 ip address 52.0.0.13 255.255.255.252
 ipv6 address fe80::25 link-local
 ipv6 address 2001:db8:520:2526::25/64
 no shutdown
!
interface Ethernet0/3
 description to R28
 ip address 52.0.1.17 255.255.255.252
 ipv6 address fe80::25 link-local
 ipv6 address 2001:db8:520:2528::25/64
 no shutdown
!
! ---------- lab02: статические маршруты до клиентов (до BGP) ----------
ip route 10.30.0.0 255.255.0.0 52.0.1.18
ip route 10.40.0.0 255.255.0.0 52.0.1.10
ipv6 route 2001:db8:1001:2800::/56 2001:db8:520:2528::28
ipv6 route 2001:db8:1001:2700::/56 2001:db8:520:2527::27
!
! ---------- lab04: IS-IS ----------
router isis TRIADA
 net 49.2222.0520.0000.0025.00
 metric-style wide
 log-adjacency-changes
 passive-interface Loopback0
 passive-interface Ethernet0/1
 passive-interface Ethernet0/3
 !
 address-family ipv6
  multi-topology
 exit-address-family
!
interface Ethernet0/0
 ip router isis TRIADA
 ipv6 router isis TRIADA
 isis network point-to-point
!
interface Ethernet0/2
 ip router isis TRIADA
 ipv6 router isis TRIADA
 isis network point-to-point
 isis circuit-type level-2-only
!
! ---------- lab07: iBGP ----------
router bgp 520
 bgp router-id 52.0.255.25
 bgp log-neighbor-changes
!
router bgp 520
 !
 address-family ipv4
 exit-address-family
!
! ---------- lab09: BGP IPv6 ----------
router bgp 520
 !
 address-family ipv4
 exit-address-family
 !
 address-family ipv6
 exit-address-family
!
! ---------- lab13: MPLS LDP ----------
mpls label protocol ldp
mpls ldp router-id Loopback0 force
!
interface Ethernet0/0
 mpls ip
!
interface Ethernet0/2
 mpls ip
!
! ---------- lab13: iBGP full mesh PE, 6PE ----------
ipv6 cef
!
router bgp 520
 neighbor 52.0.255.24 remote-as 520
 neighbor 52.0.255.24 description R24 PE
 neighbor 52.0.255.24 update-source Loopback0
 neighbor 52.0.255.26 remote-as 520
 neighbor 52.0.255.26 description R26 PE
 neighbor 52.0.255.26 update-source Loopback0
 !
 address-family ipv4
  neighbor 52.0.255.24 activate
  neighbor 52.0.255.24 next-hop-self
  neighbor 52.0.255.26 activate
  neighbor 52.0.255.26 next-hop-self
 exit-address-family
 !
 address-family ipv6
  neighbor 52.0.255.24 activate
  neighbor 52.0.255.24 send-label
  neighbor 52.0.255.24 next-hop-self
  neighbor 52.0.255.26 activate
  neighbor 52.0.255.26 send-label
  neighbor 52.0.255.26 next-hop-self
 exit-address-family
!
line con 0
 logging synchronous
 exec-timeout 0 0
!
end
