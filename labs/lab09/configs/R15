 ipv6 address 2001:db8:1001:ffff::15/128
!
interface Ethernet0/0
 description to R13
 ip address 10.10.0.10 255.255.255.252
 ipv6 address fe80::15 link-local
 ipv6 address 2001:db8:1001:1315::15/64
 no shutdown
!
interface Ethernet0/1
 description to R12
 ip address 10.10.0.14 255.255.255.252
 ipv6 address fe80::15 link-local
 ipv6 address 2001:db8:1001:1215::15/64
 no shutdown
!
interface Ethernet0/2
 description to R21
 ip address 30.1.0.2 255.255.255.252
 ipv6 address fe80::15 link-local
